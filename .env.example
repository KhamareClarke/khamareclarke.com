# Empire OS — Copy to .env. Never commit .env or SUPABASE_SERVICE_ROLE_KEY.
# Use different keys for production vs development.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

EMPIRE_PROJECT_NAME=
EMPIRE_ENV=development
EMPIRE_CRON_SECRET=

# Run tasks: either ZeroClaw (install separately) or direct LLM (no install).
# Option A — ZeroClaw: set base URL of ZeroClaw API and run ZeroClaw (e.g. cargo run in zeroclaw-app).
ZEROCLAW_URL=https://your-zeroclaw-host
# JARVIS — OpenRouter (recommended). Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# JARVIS_LLM_PROVIDER=openrouter
# Optional: Google Gemini (image gen + fallback LLM). Get key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Optional: Brave Search API for higher-quality JARVIS web search (else SearXNG / OpenRouter web)
# BRAVE_SEARCH_API_KEY=
# OPENROUTER_SEARCH_MODEL=perplexity/sonar
# Optional: model for Option B (default: openai/gpt-4o-mini). Or use EMPIRE_LLM_API_KEY / EMPIRE_LLM_MODEL.

# Cross-repo: allow MyApproved, Flip Republic, etc. to trigger Empire (webhook).
EMPIRE_WEBHOOK_SECRET=

# Worker (edit code, fix bugs). Uses OpenRouter by default; or use a custom LLM (ZeroClaw/Ollama):
# EMPIRE_LLM_API_URL=http://localhost:11434/v1   # Ollama (no key). Or your OpenAI-compatible base URL.
# EMPIRE_LLM_API_KEY=                             # Optional; required for remote APIs.
# EMPIRE_LLM_MODEL=llama3.2                       # Optional model (Ollama model name, etc.).
# EMPIRE_WORKER_ALLOWED_PATHS=                    # Comma-separated; or set per-project in config/worker.json
# EMPIRE_WORKER_ALLOWED_COMMANDS=
# EMPIRE_WORKER_PUSH_ENABLED=true                 # Allow "Commit & push" from dashboard.

LOG_LEVEL=info
